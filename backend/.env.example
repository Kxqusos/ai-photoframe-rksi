# Canonical local runtime is PostgreSQL. `DATABASE_URL` is legacy compatibility only.
# Legacy SQLite is supported only as a source for `python scripts/migrate_sqlite_to_postgres.py`.
APP__NAME=AI Photoframe API
APP__ENV=development
APP__DEFAULT_PUBLIC_ROOM_SLUG=ph000000
BACKEND_PORT=8000
BACKEND_RELOAD=false

AUTH__JWT_SECRET=change-me-in-production
AUTH__JWT_EXPIRE_MINUTES=60
AUTH__ADMIN_USERNAME=admin
AUTH__ADMIN_PASSWORD=change-me

DB__HOST=localhost
DB__PORT=5432
DB__NAME=photoframe
DB__USER=photoframe
DB__PASSWORD=photoframe
DB__ECHO=false

LOG__FILE_PATH=logs/backend.log
LOG__LEVEL=INFO

OPENROUTER__HTTP_REFERER=https://example.com
OPENROUTER__X_TITLE=AI Photoframe
OPENROUTER__PROVIDER_SORT=throughput
OPENROUTER__PREFERRED_MAX_LATENCY=25
OPENROUTER__SOURCE_MAX_SIDE=1280
OPENROUTER__SOURCE_JPEG_QUALITY=85
OPENROUTER__MISSING_IMAGE_RETRIES=3
OPENROUTER__RESULT_FORMAT=jpeg
OPENROUTER__JPEG_QUALITY=85

ROUTING_LLM_EGRESS_URL=http://llm-egress:8080
ROUTING_XRAY_CLIENT_URL=http://xray-client:8081

STORAGE__MEDIA_DIR=storage
STORAGE__RESULT_RETENTION_DAYS=7
